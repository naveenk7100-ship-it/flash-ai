# ==============================================================================
# FLASH.Ai Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & LOCAL VIDEO GENERATION (ZERO PAID AI KEYS REQUIRED)
# ------------------------------------------------------------------------------
# MoneyPrinterTurbo + Edge-TTS generates 100% free 9:16 vertical Reels with local
# video materials, Microsoft Edge TTS voiceover, and synchronized subtitles.
# No external LLM, OpenAI, or speech API keys are needed for video generation.
NODE_ENV=development
PORT=3000
MONEYPRINTER_URL=http://127.0.0.1:8080

# Hard Safety Invariants (Human Approval ON, Auto-Publish OFF)
REQUIRE_HUMAN_APPROVAL=true
AUTO_PUBLISH=false
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. OPTIONAL AI PROVIDERS (IDEATION & STUDIO VOICES)
# ------------------------------------------------------------------------------
# Only needed if you want automatic AI scriptwriting or ElevenLabs studio voiceovers:
# Gemini API: Used for automated trend mining and script generation
GEMINI_API_KEY=

# ElevenLabs: Used only for FastReelEngine studio voiceover fallback
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
ELEVENLABS_ENABLED=false

# Optional third-party providers (Not used by MoneyPrinterTurbo)
OPENAI_API_KEY=
CREATOMATE_API_KEY=
CREATOMATE_TEMPLATE_ID=

# ------------------------------------------------------------------------------
# 3. INSTAGRAM & META GRAPH API (LIVE PUBLISHING & WEBHOOKS ONLY)
# ------------------------------------------------------------------------------
# Only required when connecting to Meta Graph API for Instagram publishing:
META_INSTAGRAM_ACCOUNT_ID=17841436234295944
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_PUBLISHING_MODE=DEMO
META_WEBHOOK_VERIFY_TOKEN=flash_ai_webhook_verify_token_2026
META_APP_ID=
META_APP_SECRET=

# Public HTTPS URL accessible by Meta Graph API to download rendered MP4 videos
PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# 4. CLOUD PERSISTENCE & S3 STORAGE (EPHEMERAL CLOUD HOSTING ONLY)
# ------------------------------------------------------------------------------
# Only required when deploying to ephemeral cloud hosts (e.g., Render Free, Fly.io)
# where local disk is wiped on restart. Optional for local development:
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=
