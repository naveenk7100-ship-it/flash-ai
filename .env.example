# ===================================================
# FLASH.Ai Social Media Automation Engine Configuration
# ===================================================

# 1. SERVER & RUNTIME ENVIRONMENT
NODE_ENV=development
PORT=3000
# Set PUBLIC_BASE_URL to your production domain or HTTPS tunnel for Meta Webhook & Public Media delivery
# Example: https://flashai.yourdomain.com
PUBLIC_BASE_URL=

# 2. PERSISTENCE STORAGE ROOT
# Directory for saving daily runs, scheduled jobs, leads, and backup snapshots
STORAGE_ROOT=./server/data

# 3. PRIMARY AI PROVIDER (Google Gemini API)
# Get your free key at: https://aistudio.google.com/app/apikey
# NEVER commit your real key to version control or expose in client code!
GEMINI_API_KEY=

# 4. META / INSTAGRAM GRAPH API PUBLISHING & WEBHOOKS (Official API)
# Get credentials at: https://developers.facebook.com/apps
# Requires an Instagram Professional (Business) Account linked to a Facebook Page.
# Required Permissions:
#   - instagram_basic
#   - instagram_content_publish
#   - instagram_manage_insights
#   - pages_show_list
#   - pages_read_engagement
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_INSTAGRAM_ACCOUNT_ID=
# Verification token configured in your Meta App Webhook dashboard
META_VERIFY_TOKEN=flash_ai_webhook_verify_secret
# Publishing mode: Set to LIVE only after verifying production domain & Meta credentials
META_PUBLISHING_MODE=DEMO

# 5. OPTIONAL VOICE PROVIDERS (For 9:16 Video Reels)
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
