# ==============================================================================
# FLASH.Ai Production Environment Configuration Template (.env.production.example)
#
# IMPORTANT SECURITY NOTES:
# 1. Never commit your real .env file or real access tokens to public GitHub repositories!
# 2. In production (Render/Railway/Fly.io/VPS), enter these variables into your hosting
#    provider's secure dashboard Environment Secrets panel.
# 3. For Vercel frontend deployments, configure Vercel Environment Variables:
#    - VITE_API_BASE_URL (optional: your backend production URL, e.g. https://api.yourdomain.com)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Node.js Server & Network Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# The publicly accessible HTTPS URL of your persistent backend server.
# Required by Meta Graph API to fetch your rendered MP4 video during Instagram Reel publishing.
# Examples:
#   - Render: https://flash-ai-backend.onrender.com
#   - Railway: https://flash-ai-production.up.railway.app
#   - Fly.io: https://flash-ai.fly.dev
#   - Custom domain / VPS: https://api.flashai.digital
PUBLIC_BASE_URL=https://your-backend-domain.com

# ------------------------------------------------------------------------------
# 2. Instagram & Meta Graph API Integration (Production Credentials)
# ------------------------------------------------------------------------------
# Target Instagram Professional Account (@flash__ai__digital)
META_INSTAGRAM_ACCOUNT_ID=17841436234295944

# Long-lived Meta User / Page Access Token with instagram_content_publish permissions
META_ACCESS_TOKEN=your_long_lived_meta_access_token_here

# Meta Graph API Version (defaults to v21.0)
META_API_VERSION=v21.0

# Publishing mode: LIVE for real Instagram publishing, DEMO for dry-run verification
META_PUBLISHING_MODE=LIVE

# Meta Webhook Verification Token (for inbound comments and messages)
META_WEBHOOK_VERIFY_TOKEN=flash_ai_webhook_verify_token_2026

# Meta App ID & App Secret (optional, used for webhook HMAC verification)
META_APP_ID=
META_APP_SECRET=

# ------------------------------------------------------------------------------
# 3. Autonomous Scheduler & Safety Gates (CRITICAL SAFETY LOCKS)
# ------------------------------------------------------------------------------
# In production, requireHumanApproval=true prevents unreviewed Reels from publishing.
# Operators must review and approve Reels in the In-App Review Dashboard.
REQUIRE_HUMAN_APPROVAL=true

# autoPublish MUST remain false during staging and initial deployment tests
AUTO_PUBLISH=false

# Timezone for daily 12:00 PM IST generation and 9:00 PM IST publishing
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# 4. Standalone Python MoneyPrinterTurbo Worker Service
# ------------------------------------------------------------------------------
# URL of the containerized Python FastAPI video rendering service.
# - If running in docker-compose: http://moneyprinter:8080
# - If hosted as a separate service on Render/Railway/Fly.io: https://mpt-worker.onrender.com
# - If hosted locally on same server: http://127.0.0.1:8080
MONEYPRINTER_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 5. Persistent Storage Paths
# ------------------------------------------------------------------------------
# Directories mounted on persistent storage volumes (Render Disk, Railway Volume, Fly.io Volume)
DATA_ROOT=./data
MEDIA_ROOT=./media

# ------------------------------------------------------------------------------
# 6. AI Providers & Voice Synthesis
# ------------------------------------------------------------------------------
# Google Gemini API Key (Topic discovery, scriptwriting, storyboard formatting)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs Voice Synthesis (Production quality voiceovers)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=ibbx9zDYGvLgtYzRbqqG
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_ENABLED=true

# OpenAI API Key (Optional fallback for text generation or DALL-E)
OPENAI_API_KEY=

# Creatomate API Key (Optional cloud video renderer fallback)
CREATOMATE_API_KEY=
CREATOMATE_TEMPLATE_ID=

# ------------------------------------------------------------------------------
# 7. S3-Compatible Cloud Storage & Ephemeral Container Persistence
# ------------------------------------------------------------------------------
# Highly recommended for Render Free, Fly.io, Railway, and containerized hosts where
# local disk is ephemeral and wiped on restart:
# Supported free-tier providers:
#   - Cloudflare R2: 10 GB free permanent storage, $0 egress fees (recommended for Instagram Meta Graph API)
#   - Supabase Storage: 1 GB free bucket storage
#   - Backblaze B2: 10 GB free permanent storage
#   - AWS S3: 5 GB free for 12 months
# Set these variables in your hosting provider's dashboard to persist MP4s and review state:
S3_BUCKET=
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

